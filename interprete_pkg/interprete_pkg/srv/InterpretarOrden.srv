# Petición
string frase
string modo             # "" o "auto" (LAYA con respaldo) | "laya" (solo LAYA) | "palabras_clave" (solo respaldo)
---
# Decisión tipada (mismos campos de antes, en el mismo orden)
string accion
string objeto
string color
int32 prioridad         # 1 (sin urgencia) a 5 (emergencia)
bool permitido
bool degradado          # true si LAYA no respondió bien y se usó el respaldo

# Nuevos
string causa_rechazo    # vacío si permitido == true
string fuente           # "laya" | "palabras_clave"
string motivo           # "", "timeout", "sin_conexion", "servidor_ocupado", "respuesta_invalida", ...
bool exito              # false solo en modo "laya" si LAYA falló (no se inventa una decisión)
float64 confianza       # 0..1
float64 latencia_total_ms     # todo el callback, sin contar DDS
float64 latencia_http_ms      # ida y vuelta HTTP a LAYA (-1 = no hubo)
float64 latencia_calculo_ms   # cálculo informado por el servidor (X-Inference-Time-Ms), -1 = no disponible
float64 latencia_red_ms       # http - cálculo (red + cola del servidor), -1 = no disponible
